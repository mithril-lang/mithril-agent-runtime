#!/bin/sh
set -eu
installer="$(dirname "$0")/install-mithril.sh"
if [ "${1:-}" = '--installer-help' ]; then
    exec sh "$installer" --help
fi
export HERMES_HOME="${HERMES_HOME:-${HOME:?HOME is required}/.mithril}"
export MITHRIL_AGENT_CLI_LAUNCHER=1
runtime="$HERMES_HOME/agent/.hermes/bin/hermes"
if [ ! -x "$runtime" ]; then
    sh "$installer"
fi
if [ "${1:-}" = 'session' ]; then
    shift
    helper="$HERMES_HOME/agent/scripts/mithril-runtime/session.py"
    [ -f "$helper" ] || { printf '%s\n' 'Mithril Agent: update the runtime to enable API Profile container sessions' >&2; exit 1; }
    exec python3 -I "$helper" "$@"
fi
case "${1:-}" in
    login|logout|account) exec "$runtime" --run-module hermes_cli.mithril_auth "$@";;
    auth)
        case "${2:-}" in
            login|logout|status) exec "$runtime" --run-module hermes_cli.mithril_auth "$@";;
        esac;;
    -p|--profile)
        case "${3:-}" in
            login|logout|account) exec "$runtime" --run-module hermes_cli.mithril_auth "$@";;
            auth)
                case "${4:-}" in
                    login|logout|status) exec "$runtime" --run-module hermes_cli.mithril_auth "$@";;
                esac;;
        esac;;
esac
exec "$runtime" "$@"
