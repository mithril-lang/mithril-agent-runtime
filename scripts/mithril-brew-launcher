#!/bin/sh
set -eu
installer="$(dirname "$0")/install-mithril.sh"
release_version='0.1.0-preview.20261025.t0515'
if [ "${1:-}" = '--installer-help' ]; then
    exec sh "$installer" --help
fi
export HERMES_HOME="${HERMES_HOME:-${HOME:?HOME is required}/.mithril}"
export MITHRIL_AGENT_CLI_LAUNCHER=1
export MITHRIL_AGENT=1
export MITHRIL_INSTALL_HOME="$HERMES_HOME"
runtime_root="$HERMES_HOME/agent"
if [ -L "$HERMES_HOME/agent-current" ]; then
    runtime_root="$HERMES_HOME/agent-current"
fi
runtime="$runtime_root/.hermes/bin/hermes"
if [ ! -x "$runtime" ]; then
    [ ! -L "$HERMES_HOME/agent-current" ] || { printf '%s\n' 'Mithril CLI selection is incomplete; use the retained runtime to roll back' >&2; exit 1; }
    sh "$installer"
fi
export MITHRIL_RUNTIME_ROOT="$runtime_root"
# preview.6 predates the updater. The qualified wrapper carries the bootstrap
# verifier; its public root comes from this formula, never an environment path.
update_module() {
    if [ -f "$runtime_root/hermes_cli/mithril_updates.py" ]; then
        exec "$runtime" --run-module hermes_cli.mithril_updates "$@"
    fi
    exec python3 -I "$(dirname "$0")/mithril-update-bootstrap.py" "$@"
}
if [ "${1:-}" = 'session' ]; then
    shift
    helper="$runtime_root/scripts/mithril-runtime/session.py"
    [ -f "$helper" ] || { printf '%s\n' 'Mithril Agent: update the runtime to enable API Profile container sessions' >&2; exit 1; }
    exec python3 -I "$helper" "$@"
fi
case "${1:-}" in
    -V|--version) update_module version --fallback-version "$release_version";;
    update) update_module "$@";;
    login|logout|account) exec "$runtime" --run-module hermes_cli.mithril_auth "$@";;
    auth)
        case "${2:-}" in
            login|logout|status) exec "$runtime" --run-module hermes_cli.mithril_auth "$@";;
        esac;;
    -p|--profile)
        case "${3:-}" in
            -V|--version) update_module -p "${2:-}" version --fallback-version "$release_version";;
            update) update_module "$@";;
            login|logout|account) exec "$runtime" --run-module hermes_cli.mithril_auth "$@";;
            auth)
                case "${4:-}" in
                    login|logout|status) exec "$runtime" --run-module hermes_cli.mithril_auth "$@";;
                esac;;
        esac;;
esac
exec "$runtime" "$@"
