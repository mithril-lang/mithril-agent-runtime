#!/bin/sh
# Keep Mithril's profile path at the launcher boundary; use the existing Hermes runtime.
export HERMES_HOME="${HERMES_HOME:-${HOME:?HOME is required}/.mithril}"
export MITHRIL_AGENT_CLI_LAUNCHER=1
export MITHRIL_AGENT=1
export MITHRIL_INSTALL_HOME="$HERMES_HOME"
hermes_launcher="$(dirname "$0")/hermes"
if [ -L "$HERMES_HOME/agent-current" ]; then
    runtime="$HERMES_HOME/agent-current/.hermes/bin/hermes"
    [ -x "$runtime" ] || { printf '%s\n' 'Mithril CLI selection is incomplete; run mithril update --rollback' >&2; exit 1; }
elif [ -x "$hermes_launcher" ]; then
    runtime="$hermes_launcher"
else
    runtime=hermes
fi
case "${1:-}" in
    update) exec "$runtime" --run-module hermes_cli.mithril_updates "$@";;
    login|logout|account) exec "$runtime" --run-module hermes_cli.mithril_auth "$@";;
    auth)
        case "${2:-}" in
            login|logout|status) exec "$runtime" --run-module hermes_cli.mithril_auth "$@";;
        esac;;
    -p|--profile)
        case "${3:-}" in
            update) exec "$runtime" --run-module hermes_cli.mithril_updates "$@";;
            login|logout|account) exec "$runtime" --run-module hermes_cli.mithril_auth "$@";;
            auth)
                case "${4:-}" in
                    login|logout|status) exec "$runtime" --run-module hermes_cli.mithril_auth "$@";;
                esac;;
        esac;;
esac
exec "$runtime" "$@"
